# ─────────────────────────────────────────────────────────────────────────────
# SecureOps Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API — used by the AI Analyst view (client-side demo only)
# In production, proxy all AI requests through your backend to protect the key.
# Get your key at: https://console.anthropic.com/settings/api-keys
VITE_ANTHROPIC_API_KEY=sk_live_your_key_here

# App metadata
VITE_APP_VERSION=3.0.0
VITE_APP_ENV=development           # development | staging | production

# API endpoints (when wired to a real backend)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Feature flags
VITE_ENABLE_AI_ANALYST=true
VITE_ENABLE_LIVE_EVENTS=true
VITE_ENABLE_BILLING=true
